---
import Base from '../layouts/Base.astro';
import site from '../../site.json';
const webcal = site.agenda.icalUrl.replace(/^https?:/, 'webcal:');
---
<Base titel="Agenda" omschrijving="HAGRO-agenda van de huisartsen in Leusden en Achterveld">
  <div class="kop-rij">
    <div>
      <h1>Agenda</h1>
      <p class="intro" style="margin-bottom:0">Scholingen, FTO's, HAGRO-vergaderingen en andere bijeenkomsten. Bron: de openbare Google-agenda "{site.agenda.naam}".</p>
    </div>
    <div class="rij">
      <a class="knop" href={webcal} title="Opent je agenda-app en abonneert op de HAGRO-agenda">Abonneren in je agenda</a>
      <a class="knop secundair" href={site.agenda.googleWebUrl} target="_blank" rel="noopener">Open in Google Agenda</a>
    </div>
  </div>

  <p class="klein zacht" id="agenda-bijgewerkt"></p>
  <div id="agenda"><p class="zacht">Agenda wordt geladen…</p></div>

  <details class="kaart" style="margin-top:32px">
    <summary style="cursor:pointer;font-weight:600">Agenda toevoegen aan je eigen agenda-app (iCal)</summary>
    <div style="margin-top:12px" class="klein">
      <p>Gebruik dit adres om je te abonneren; wijzigingen in de HAGRO-agenda komen dan automatisch mee.</p>
      <p><code id="ical-url" style="word-break:break-all">{site.agenda.icalUrl}</code> <button class="knop klein secundair" type="button" id="kopieer">Kopieer</button></p>
      <ul>
        <li><b>Google Agenda:</b> Andere agenda's → + → Via URL → adres plakken.</li>
        <li><b>Outlook:</b> Agenda toevoegen → Abonneren op internet → adres plakken.</li>
        <li><b>Apple Agenda / iPhone:</b> klik op "Abonneren in je agenda" hierboven, of Instellingen → Agenda → Accounts → Agenda-abonnement toevoegen.</li>
      </ul>
      <p>Wil je zelf activiteiten toevoegen aan de HAGRO-agenda? Dat gaat via Google Agenda; vraag bewerkrechten aan bij de beheerder.</p>
    </div>
  </details>

  <script src="../scripts/agenda.ts"></script>
  <script>
    document.getElementById('kopieer')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(document.getElementById('ical-url')!.textContent!.trim()); b.textContent = 'Gekopieerd'; setTimeout(() => (b.textContent = 'Kopieer'), 1500); } catch {}
    });
  </script>
</Base>
