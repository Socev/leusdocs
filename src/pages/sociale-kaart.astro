---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { GROEPEN, GGZ_NIVEAUS, groepVanCategorie } from '../../shared/velden.mjs';
import { datumLang } from '../lib/datum';

// Alfabetisch; items die nog gecontroleerd moeten worden onderaan
const items = (await getCollection('sociale-kaart')).sort((a, b) => Number(a.data.concept) - Number(b.data.concept) || a.data.naam.localeCompare(b.data.naam, 'nl'));
const gerenderd = await Promise.all(
  items.map(async (i) => ({ ...i, Body: (await render(i)).Content, heeftBody: !!i.body?.trim().length, groep: groepVanCategorie(i.data.categorie).id })),
);
const nettoTel = (t: string) => t.replace(/[^\d+]/g, '');
const perGroep = GROEPEN.map((g) => ({
  ...g,
  items: gerenderd.filter((i) => i.groep === g.id),
  categorieen: g.categorieen.filter((c) => gerenderd.some((i) => i.data.categorie === c)),
}));
---
<Base titel="Sociale kaart" omschrijving="Sociale kaart voor huisartsen en POH-GGZ in Leusden en Achterveld">
  <div class="kop-rij">
    <div>
      <h1>Sociale kaart</h1>
      <p class="intro" style="margin-bottom:0">Waar verwijs je naartoe in en om Leusden? Klikbare contactgegevens, doelgroep en verwijsroute. Bijgehouden door de POH-GGZ en de praktijken.</p>
    </div>
    <a class="knop secundair" href="/beheer#sociale-kaart">Toevoegen of wijzigen</a>
  </div>

  <div class="sk-tabs" role="tablist" aria-label="Onderdeel van de sociale kaart">
    {perGroep.map((g, n) => (
      <button class="sk-tab" role="tab" type="button" data-groep={g.id} aria-selected={n === 0 ? 'true' : 'false'}>
        {g.label} <span class="sk-tab-aantal">{g.items.length}</span>
      </button>
    ))}
  </div>

  {perGroep.map((g, n) => (
    <section class="sk-paneel" data-groep={g.id} role="tabpanel" hidden={n !== 0}>
      <p class="zacht klein" style="margin:0 0 14px">{g.omschrijving}</p>
      <div class="filters" role="search">
        <input type="search" class="sk-zoek" placeholder="Zoek op naam, trefwoord, doelgroep…" aria-label="Zoeken" autocomplete="off" />
        <select class="sk-categorie" aria-label="Categorie">
          <option value="">Alle categorieën ({g.items.length})</option>
          {g.categorieen.map((c) => <option value={c}>{c} ({g.items.filter((i) => i.data.categorie === c).length})</option>)}
        </select>
      </div>
      <div class="chips" role="group" aria-label="Filters">
        {g.id === 'ggz' && GGZ_NIVEAUS.map((n) => (
          <button type="button" class="chip sk-niveau" data-niveau={n} aria-pressed="false">{n} <span class="chip-aantal">{g.items.filter((i) => i.data.ggz_niveau.includes(n)).length}</span></button>
        ))}
        <button type="button" class="chip sk-open" aria-pressed="false">Verberg aanmeldstops <span class="chip-aantal">{g.items.filter((i) => i.data.aanmeldstop).length}</span></button>
      </div>

      <div class="grid sk-lijst">
        {g.items.map((i) => (
          <article
            class="kaart sk-kaart"
            data-categorie={i.data.categorie}
            data-stop={i.data.aanmeldstop ? '1' : ''}
            data-niveau={i.data.ggz_niveau.join('|')}
            data-zoek={[i.data.naam, i.data.omschrijving, i.data.doelgroep, i.data.adres, ...(i.data.tags ?? []), i.data.categorie].filter(Boolean).join(' ').toLowerCase()}
            id={i.id}
          >
            <div class="rij tussen">
              <span class="rij" style="gap:4px"><span class="label">{i.data.categorie}</span>{i.data.ggz_niveau.filter((n) => n !== 'Overig').map((n) => <span class="label niveau">{n}</span>)}</span>
              {i.data.concept && <span class="label let-op" title="Gegevens zijn nog niet gecontroleerd">Nog te controleren</span>}
            </div>
            <h3>{i.data.website ? <a href={i.data.website} target="_blank" rel="noopener">{i.data.naam}</a> : i.data.naam}</h3>
            <p style="margin:0">{i.data.omschrijving}</p>
            <ul class="sk-contact">
              {i.data.website && <li><span class="k">Website</span><a href={i.data.website} target="_blank" rel="noopener">{i.data.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>}
              {i.data.telefoon && <li><span class="k">Telefoon</span><a href={`tel:${nettoTel(i.data.telefoon)}`}>{i.data.telefoon}</a></li>}
              {i.data.email && <li><span class="k">E-mail</span><a href={`mailto:${i.data.email}`}>{i.data.email}</a></li>}
              {i.data.adres && <li><span class="k">Adres</span><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(i.data.adres)}`} target="_blank" rel="noopener">{i.data.adres}</a></li>}
            </ul>
            {(i.data.doelgroep || i.data.verwijzen || i.data.wachttijd) && (
              <div class="sk-meta">
                {i.data.doelgroep && <span><b>Doelgroep:</b> {i.data.doelgroep}</span>}
                {i.data.verwijzen && <span><b>Verwijzen:</b> {i.data.verwijzen}</span>}
                {i.data.wachttijd && <span><b>Wachttijd:</b> {i.data.wachttijd}</span>}
              </div>
            )}
            {i.heeftBody && <div class="sk-toelichting"><i.Body /></div>}
            <div class="as-blok" data-id={i.id}>
              {i.data.aanmeldstop ? (
                <div class="as-status stop">
                  <b>Aanmeldstop</b>{i.data.aanmeldstop_vanaf && ` sinds ${datumLang(i.data.aanmeldstop_vanaf)}`}{i.data.aanmeldstop_toelichting && ` · ${i.data.aanmeldstop_toelichting}`}
                  {i.data.aanmeldstop_gemeld && <span class="as-gemeld">gemeld {datumLang(i.data.aanmeldstop_gemeld)}</span>}
                </div>
              ) : i.data.aanmeldstop_gemeld ? (
                <div class="as-status open"><b>Neemt patiënten aan</b>{i.data.aanmeldstop_toelichting && ` · ${i.data.aanmeldstop_toelichting}`}<span class="as-gemeld">gemeld {datumLang(i.data.aanmeldstop_gemeld)}</span></div>
              ) : null}
              <button type="button" class="as-knop" data-id={i.id} data-naam={i.data.naam} data-stop={i.data.aanmeldstop ? '1' : ''} data-vanaf={i.data.aanmeldstop_vanaf ? i.data.aanmeldstop_vanaf.toISOString().slice(0, 10) : ''} data-toelichting={i.data.aanmeldstop_toelichting ?? ''}>
                {i.data.aanmeldstop ? 'Aanmeldstop wijzigen of opheffen' : 'Aanmeldstop melden'}
              </button>
            </div>
            <div class="rij tussen" style="margin-top:auto">
              {i.data.tags?.length ? <div class="tags">{i.data.tags.slice(0, 6).map((t) => <span class="tag">{t}</span>)}</div> : <span />}
              {i.data.bijgewerkt && <span class="klein zacht">gecontroleerd {datumLang(i.data.bijgewerkt)}</span>}
            </div>
          </article>
        ))}
      </div>
      <p class="leeg sk-leeg" hidden>Geen organisaties gevonden. <a href="/beheer#sociale-kaart">Voeg er een toe</a>.</p>
    </section>
  ))}

  <dialog id="as-dialog" class="as-dialog">
    <form method="dialog" id="as-form" autocomplete="off">
      <h3 style="margin:0 0 4px">Aanmeldstop melden</h3>
      <p class="klein zacht" id="as-naam" style="margin:0 0 14px"></p>
      <label class="as-optie"><input type="radio" name="as-status" value="stop" checked /> Heeft een aanmeldstop (neemt geen nieuwe patiënten aan)</label>
      <label class="as-optie"><input type="radio" name="as-status" value="open" /> Neemt (weer) patiënten aan</label>
      <div class="as-velden" id="as-stopvelden">
        <label class="as-veld"><span>Vanaf (optioneel)</span><input type="date" name="vanaf" /></label>
      </div>
      <label class="as-veld"><span>Toelichting (optioneel, bv. "alleen voor VGZ/Zilveren Kruis" of "tot 1 januari")</span><input type="text" name="toelichting" maxlength="200" /></label>
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <p class="klein zacht" style="margin:10px 0 0">Je melding is direct openbaar zichtbaar met de datum van vandaag, zonder je naam. Na 1–2 minuten staat hij definitief op de site.</p>
      <p class="as-fout" id="as-fout" hidden></p>
      <div class="rij" style="margin-top:14px">
        <button type="submit" class="knop" id="as-verstuur">Melding opslaan</button>
        <button type="button" class="knop secundair" id="as-annuleer">Annuleren</button>
      </div>
    </form>
  </dialog>

  <script>
    // ---- Aanmeldstop melden (openbaar) ----
    const dlg = document.getElementById('as-dialog') as HTMLDialogElement;
    const asForm = document.getElementById('as-form') as HTMLFormElement;
    const fDatum = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    let asId = '';
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.as-knop');
      if (!b) return;
      asId = b.dataset.id!;
      (document.getElementById('as-naam') as HTMLElement).textContent = b.dataset.naam!;
      const stop = b.dataset.stop === '1';
      (asForm.elements.namedItem('as-status') as RadioNodeList).value = stop ? 'stop' : 'stop';
      (asForm.elements.namedItem('vanaf') as HTMLInputElement).value = b.dataset.vanaf || '';
      (asForm.elements.namedItem('toelichting') as HTMLInputElement).value = b.dataset.toelichting || '';
      (document.getElementById('as-fout') as HTMLElement).hidden = true;
      (dlg.querySelector('h3') as HTMLElement).textContent = stop ? 'Aanmeldstop wijzigen' : 'Aanmeldstop melden';
      toggleStopVelden();
      dlg.showModal();
    });
    function toggleStopVelden() {
      const v = (asForm.elements.namedItem('as-status') as RadioNodeList).value;
      (document.getElementById('as-stopvelden') as HTMLElement).hidden = v !== 'stop';
    }
    asForm.addEventListener('change', toggleStopVelden);
    document.getElementById('as-annuleer')!.addEventListener('click', () => dlg.close());
    asForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const knop = document.getElementById('as-verstuur') as HTMLButtonElement;
      const fout = document.getElementById('as-fout') as HTMLElement;
      knop.disabled = true; knop.textContent = 'Opslaan…'; fout.hidden = true;
      const stop = (asForm.elements.namedItem('as-status') as RadioNodeList).value === 'stop';
      const body = {
        id: asId,
        aanmeldstop: stop,
        vanaf: stop ? (asForm.elements.namedItem('vanaf') as HTMLInputElement).value : '',
        toelichting: (asForm.elements.namedItem('toelichting') as HTMLInputElement).value.trim(),
        website: (asForm.elements.namedItem('website') as HTMLInputElement).value,
      };
      try {
        const r = await fetch('/api/aanmeldstop', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.fout || `HTTP ${r.status}`);
        // Kaart direct bijwerken (de site zelf bouwt in 1–2 minuten opnieuw)
        const blok = document.querySelector<HTMLElement>(`.as-blok[data-id="${CSS.escape(asId)}"]`);
        if (blok) {
          (blok.closest('.sk-kaart') as HTMLElement).dataset.stop = stop ? '1' : '';
          const vandaag = fDatum.format(new Date());
          const toel = body.toelichting ? ` · ${esc(body.toelichting)}` : '';
          const status = stop
            ? `<div class="as-status stop"><b>Aanmeldstop</b>${body.vanaf ? ` sinds ${fDatum.format(new Date(body.vanaf))}` : ''}${toel}<span class="as-gemeld">gemeld ${vandaag}</span></div>`
            : `<div class="as-status open"><b>Neemt patiënten aan</b>${toel}<span class="as-gemeld">gemeld ${vandaag}</span></div>`;
          const naam = blok.querySelector<HTMLButtonElement>('.as-knop')!.dataset.naam!;
          blok.innerHTML = `${status}<button type="button" class="as-knop" data-id="${esc(asId)}" data-naam="${esc(naam)}" data-stop="${stop ? '1' : ''}" data-vanaf="${esc(body.vanaf)}" data-toelichting="${esc(body.toelichting)}">${stop ? 'Aanmeldstop wijzigen of opheffen' : 'Aanmeldstop melden'}</button>`;
        }
        dlg.close();
      } catch (err: any) {
        fout.textContent = `Opslaan mislukt: ${err.message}`;
        fout.hidden = false;
      } finally { knop.disabled = false; knop.textContent = 'Melding opslaan'; }
    });

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.sk-tab'));
    const panelen = Array.from(document.querySelectorAll<HTMLElement>('.sk-paneel'));
    const params = new URLSearchParams(location.search);

    function toonGroep(id: string, schrijfUrl = true) {
      for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.groep === id));
      for (const p of panelen) p.hidden = p.dataset.groep !== id;
      if (schrijfUrl) { params.set('groep', id); history.replaceState(null, '', `?${params}`); }
    }
    tabs.forEach((t) => t.addEventListener('click', () => toonGroep(t.dataset.groep!)));

    for (const p of panelen) {
      const zoek = p.querySelector<HTMLInputElement>('.sk-zoek')!;
      const cat = p.querySelector<HTMLSelectElement>('.sk-categorie')!;
      const open = p.querySelector<HTMLButtonElement>('.sk-open')!;
      const niveaus = Array.from(p.querySelectorAll<HTMLButtonElement>('.sk-niveau'));
      const aan = (b: HTMLButtonElement) => b.getAttribute('aria-pressed') === 'true';
      const kaarten = Array.from(p.querySelectorAll<HTMLElement>('.sk-kaart'));
      const leeg = p.querySelector<HTMLElement>('.sk-leeg')!;
      const filter = () => {
        const q = zoek.value.trim().toLowerCase();
        const c = cat.value;
        let n = 0;
        const gekozen = niveaus.filter(aan).map((b) => b.dataset.niveau!);
        for (const k of kaarten) {
          const kn = (k.dataset.niveau ?? '').split('|').filter(Boolean);
          const niveauOk = !gekozen.length || gekozen.some((n) => kn.includes(n));
          const ok = (!c || k.dataset.categorie === c) && (!q || (k.dataset.zoek ?? '').includes(q)) && !(aan(open) && k.dataset.stop === '1') && niveauOk;
          k.hidden = !ok;
          if (ok) n++;
        }
        leeg.hidden = n > 0;
        if (!p.hidden) {
          q ? params.set('q', q) : params.delete('q');
          c ? params.set('cat', c) : params.delete('cat');
          gekozen.length ? params.set('niveau', gekozen.join(',')) : params.delete('niveau');
          history.replaceState(null, '', params.toString() ? `?${params}` : location.pathname);
        }
      };
      zoek.addEventListener('input', filter);
      cat.addEventListener('change', filter);
      for (const b of [open, ...niveaus]) b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(!aan(b))); filter(); });
      p.dataset.init = '1';
      (p as any).__filter = filter;
    }

    // Beginstand uit de URL: ?groep=zorg&cat=Huisartsen&q=…  (of een #anker naar een kaart)
    let start = params.get('groep') ?? '';
    const anker = location.hash.slice(1);
    if (anker) {
      const kaart = document.getElementById(anker);
      const paneel = kaart?.closest<HTMLElement>('.sk-paneel');
      if (paneel) start = paneel.dataset.groep!;
    }
    if (!panelen.some((p) => p.dataset.groep === start)) start = panelen[0].dataset.groep!;
    toonGroep(start, false);
    const actief = panelen.find((p) => p.dataset.groep === start)!;
    if (params.get('q')) actief.querySelector<HTMLInputElement>('.sk-zoek')!.value = params.get('q')!;
    if (params.get('cat')) actief.querySelector<HTMLSelectElement>('.sk-categorie')!.value = params.get('cat')!;
    for (const n of (params.get('niveau') ?? '').split(',')) actief.querySelector<HTMLButtonElement>(`.sk-niveau[data-niveau="${CSS.escape(n)}"]`)?.setAttribute('aria-pressed', 'true');
    (actief as any).__filter();
    if (anker) document.getElementById(anker)?.scrollIntoView({ block: 'start' });
  </script>
</Base>
